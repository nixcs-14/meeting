# SQLite — fichier local, aucune base externe à provisionner.
# Le chemin est relatif à prisma/schema.prisma, donc ce fichier sera créé
# à prisma/dev.db lors de la première migration.
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer le cookie de session (JWT).
# Générer avec : openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Liste blanche des AAF autorisés à se connecter, séparés par des virgules.
# (Alternative à la liste codée en dur dans src/lib/constants.ts —
# si cette variable est définie, elle prend le dessus.)
AAF_WHITELIST="nicolas.ramahalefitra@undp.org,sitraka.rasolohery@undp.org,nekena.razafinjatovo@undp.org,andrilalao.raminosoa@undp.org"
