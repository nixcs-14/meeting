# SQLite local (dev uniquement) — fichier créé automatiquement par
# `prisma migrate dev`. Ignoré en production si TURSO_DATABASE_URL est défini.
DATABASE_URL="file:./dev.db"

# Turso (production / Vercel) — obligatoire pour déployer, car Vercel n'a
# pas de disque persistant pour un fichier SQLite classique.
# Créer la base : turso db create salle-reunion
# Récupérer l'URL : turso db show salle-reunion --url
# Créer un token : turso db tokens create salle-reunion
TURSO_DATABASE_URL="libsql://booking-nixcs-14.aws-eu-west-1.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicm8iLCJpYXQiOjE3ODg3ODEwOTksImlkIjoiMDFhMDdiYTktMGYwMS03ZjM0LTliY2UtMTM4ODRmM2ExYmRiIiwia2lkIjoiMHdlY2dwcEVwakFKbkVibVlSc0VmSlU3TGJNdFRuS0hiTWVNaHp1ZEo5SSIsInJpZCI6IjhkY2U5ZTQ3LTBjOWItNDE4NS05ZjAyLWQ0NjVlNjFmMzY2YyJ9.NvEpPhN9NT-p5OB6O3npLSKRoWkk_Xtm2vQjMkA1mLy7i-Yv1Y89qYHiB4AxGgAf-fqlVNSIWvuwE5nD3SQ8Cw"

